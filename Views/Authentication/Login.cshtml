@model LoginVM

<div class="sm:flex lg:h-full">
    @* Login Form *@
    <div class="relative lg:w-[580px] md:w-96 p-10 min-h-screen bg-white shadow-xl flex items-center pt-10 z-10">
        <div class="w-full lg:max-w-sm mx-auto space-y-10">
            <div>
                <h2 class="text-2xl font-semibold mb-1.5 !text-black">Sign in to your account</h2>
                <p class="text-sm text-gray-700 font-normal">If you have not signed up yet. <a asp-controller="Authentication" asp-action="Register" class="text-blue-700">Register here!</a></p>
            </div>
            <form asp-controller="Authentication" asp-action="Login" method="post" class="space-y-7 text-sm !text-black font-medium">
                <div>
                    <label asp-for="Email">Email Address</label>
                    <div class="mt-2.5">
                        <input asp-for="Email" id="Email" name="Email" type="email"  placeholder="Email" required class="!w-full" autocomplete="off"/>
                        <span asp-validation-for="Email" class="text-red-500 text-xs mt-1"></span>
                    </div>
                </div>
                <div>
                    <label asp-for="Password">Password</label>
                    <div class="mt-2.5">
                        <input asp-for="Password" id="Password" name="Password" type="password" placeholder="****" required class="!w-full" />
                        <span asp-validation-for="Password" class="text-red-500 text-xs mt-1"></span>
                    </div>
                </div>
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2.5">
                        <input asp-for="RememberMe" id="RememberMe" name="RememberMe" type="checkbox" />
                        <label asp-for="RememberMe" class="font-normal">Remember Me</label>
                    </div>
                    <a href="#" class="text-blue-700">Forgot password</a>
                </div>
                <div class="col-span-2 text-red-500 text-xs mt-1" asp-validation-summary="ModelOnly"></div>
                <div>
                    <button type="submit" class="button bg-primary text-white w-full">Sign in</button>
                </div>
                <div class="text-center flex items-center gap-6">
                    <hr class="flex-1 border-slate-200" />
                    Or continue with
                    <hr class="flex-1 border-slate-200" />
                </div>
                <div class="flex gap-2">
                    <button type="button" class="button flex-1 flex items-center gap-2 bg-primary text-white text-sm not-allowed" disabled> <ion-icon name="logo-google" class="text-lg"></ion-icon> google </button>
                    <button type="button" class="button flex-1 flex items-center gap-2 bg-black text-white text-sm not-allowed" disabled><ion-icon name="logo-github" class="text-lg"></ion-icon> github </button>
                </div>

            </form>
        </div>
    </div>

    @* Image Slider *@
    <div class="flex-1 relative bg-primary max-md:hidden">
        <div class="relative w-full h-full" tabindex="-1" uk-slideshow="animation: slide; autoplay: true">

            <ul class="uk-slideshow-items w-full h-full">
                <li class="w-full">
                    <img src="~/images/login/welcome-01.jpg" alt="" class="w-full h-full object-cover uk-animation-kenburns uk-animation-reverse uk-transform-origin-center-left">

                    <div class="absolute bottom-0 w-full uk-transition-slide-bottom-small z-10">
                        <div class="max-w-xl w-full mx-auto pb-32 px-5 z-30 relative">
                            <h4 class="!text-white text-2xl font-semibold mt-7" uk-slideshow-parallax="y: 600,0,0">Connect with the DMV Community</h4>
                            <p class="!text-white text-lg mt-7 leading-8" uk-slideshow-parallax="y: 800,0,0;">Bridge the gap between miles and moments—connect with coworkers and weave connections together, one click at a time.</p>
                        </div>
                    </div>
                    <div class="w-full h-96 bg-gradient-to-t from-black absolute bottom-0 left-0"></div>
                </li>
                <li class="w-full">
                    <img src="~/images/login/welcome-02.jpg" alt="" class="w-full h-full object-cover uk-animation-kenburns uk-animation-reverse uk-transform-origin-center-left">
                    <div class="absolute bottom-0 w-full uk-tr ansition-slide-bottom-small z-10">
                        <div class="max-w-xl w-full mx-auto pb-32 px-5 z-30 relative">
                            <h4 class="!text-white text-2xl font-semibold mt-7" uk-slideshow-parallax="y: 800,0,0">  Connect With Co-Workers </h4>
                            <p class="!text-white text-lg mt-7 leading-8" uk-slideshow-parallax="y: 800,0,0;"> Build stronger ties and spark new ones—your next 'Remember when...' moment is just a connection request away.</p>
                        </div>
                    </div>
                    <div class="w-full h-96 bg-gradient-to-t from-black absolute bottom-0 left-0"></div>
                </li>
            </ul>

            <!-- slide nav -->
            <div class="flex justify-center">
                <ul class="inline-flex flex-wrap justify-center  absolute bottom-8 gap-1.5 uk-dotnav uk-slideshow-nav"> </ul>
            </div>

        </div>
    </div>
</div>